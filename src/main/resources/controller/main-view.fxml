<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="mpp.telodon.controller.MainController"
            prefHeight="400.0" prefWidth="600.0">
    <TableView fx:id="caritabilTable">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="150"/>
            <TableColumn fx:id="denumireColumn" text="Denumire" prefWidth="300"/>
            <TableColumn fx:id="totalColumn" text="Total" prefWidth="150"/>
        </columns>
    </TableView>
</AnchorPane>
